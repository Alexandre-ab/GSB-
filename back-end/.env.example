# Configuration du serveur
PORT=5000
NODE_ENV=development

# Base de données MongoDB
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority

# Sécurité - Clés de chiffrement
SALT=votre_salt_aleatoire
JWT_SECRET=votre_secret_jwt_aleatoire
SESSION_SECRET=votre_secret_session_aleatoire

# Google OAuth 2.0
GOOGLE_CLIENT_ID=votre_google_client_id
GOOGLE_CLIENT_SECRET=votre_google_client_secret
GOOGLE_CALLBACK_URL=/auth/google/callback

# AWS S3 (pour le stockage des fichiers)
AWS_ACCESS_KEY_ID=votre_aws_access_key
AWS_SECRET_ACCESS_KEY=votre_aws_secret_key
AWS_BUCKET_NAME=votre_bucket_name

# Frontend URL (pour les redirections OAuth)
FRONTEND_URL=https://votre-frontend-url.com
