{
  "name": "gsb-app",
  "version": "1.0.0",
  "description": "Application GSB - Front-end React et Back-end Node.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd back-end && npm run dev",
    "dev:frontend": "cd front-end && npm run dev",
    "build": "npm run install:all && cd front-end && npm run build",
    "start": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "start:backend": "cd back-end && npm start",
    "start:frontend": "cd front-end && npm run preview",
    "install:all": "npm install && cd back-end && npm install && cd ../front-end && npm install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-session": "^1.18.1",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.17.0",
    "passport": "^0.7.0",
    "passport-azure-ad": "^4.3.5",
    "passport-google-oauth20": "^2.0.0"
  }
}
